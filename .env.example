# Database URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Test database URL
TEST_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Generate a unique random secret of at least 32 bytes for visitor JWT signing and IP HMACs.
VISITOR_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Proposed SA-5 visitor-session limits (minutes/hours/count per IP).
VISITOR_SESSION_IDLE_MINUTES=30
VISITOR_SESSION_MAX_HOURS=24
VISITOR_SESSION_ACCESS_TOKEN_MINUTES=15
VISITOR_SESSION_CREATIONS_PER_HOUR=5